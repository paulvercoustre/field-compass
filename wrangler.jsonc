{
  // Cloudflare Workers static assets — deploys the marketing site in site/.
  //
  // This is an assets-only Worker: there is no `main` script, so Cloudflare
  // serves the files directly from its edge and never invokes Worker code.
  // That matters for site/_headers, whose rules apply to static asset
  // responses but NOT to responses generated by a Worker — with no Worker in
  // the path, every response is a static asset and the CSP always applies.
  //
  // The application is NOT deployed from here. It runs on the Azure VM behind
  // Caddy at app.fieldcompass.org; see docker-compose.prod.yml.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "field-compass",
  "compatibility_date": "2026-08-01",
  // The site is reachable at fieldcompass.org. Leaving workers.dev on would
  // publish a second copy at field-compass.<account>.workers.dev — a duplicate
  // URL for every page, which splits search ranking and gives out an address
  // that is not the brand. Preview URLs go with it, which is fine: builds for
  // non-production branches are off.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./site"
  }
}
