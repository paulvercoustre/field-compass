# ============================================================================
# Field Compass Environment Variables
# ============================================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control (it's in .gitignore)
# ============================================================================

# Database Configuration
# For local development with Docker Compose, this is usually:
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/field_compass

# For local development outside Docker, use:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/field_compass

# In PRODUCTION, this must use your real POSTGRES_PASSWORD (set below), e.g.:
# DATABASE_URL=postgresql://postgres:<YOUR_POSTGRES_PASSWORD>@postgres:5432/field_compass

# ============================================================================
# SECURITY -- REQUIRED IN PRODUCTION
# ============================================================================
# The production stack (docker-compose.prod.yml) will REFUSE TO START if any
# of these are missing. That is deliberate: the app previously fell back to
# insecure built-in defaults, which is worse than failing loudly.
#
# Generate a fresh value for each one. Never reuse the examples below, never
# copy values between environments, and never commit real values to git.

# Signs login tokens (JWT). Anyone who knows this value can forge a login
# token for ANY user, so it must be secret and random.
#   Generate with:  openssl rand -hex 32
JWT_SECRET_KEY=generate_me_openssl_rand_hex_32

# How long a login stays valid, in minutes. 1440 = 24 hours.
JWT_EXPIRE_MINUTES=1440

# Encrypts each user's stored KoboToolbox API token in the database.
# MUST be a valid Fernet key (44-character urlsafe base64), not a random hex
# string -- the app will fail to start otherwise.
#   Generate with:
#     python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# WARNING: changing this later makes already-stored Kobo tokens unreadable;
# affected users must re-enter their Kobo token.
ENCRYPTION_KEY=generate_me_valid_fernet_key

# Postgres password. Must match the password inside DATABASE_URL below.
#   Generate with:  openssl rand -base64 24
POSTGRES_USER=postgres
POSTGRES_PASSWORD=generate_me_openssl_rand_base64_24
POSTGRES_DB=field_compass

# Which origins the browser may call the API from. Set this to your real
# public URL. Do NOT use "*" -- that would let any website call your API
# with a logged-in user's credentials.
CORS_ORIGINS=https://your-domain-or-vm-ip

# How the site is served, and whether you get HTTPS.
#   https://your-domain.example.org  -> Caddy gets a free Let's Encrypt cert
#                                       automatically. Required for real HTTPS.
#   :80                              -> plain HTTP, no certificate. Demo only:
#                                       passwords cross the network in clear.
# Let's Encrypt cannot issue certificates for a bare IP address, so a domain is
# required for HTTPS. Set CORS_ORIGINS to match this value.
SITE_ADDRESS=:80

# The marketing site (site/), served by the same Caddy on a SEPARATE hostname.
# Recommended split, which keeps the app's cookies and its strict CSP isolated
# from anything the public page loads:
#   WWW_ADDRESS=https://fieldcompass.example.org        (the landing page)
#   SITE_ADDRESS=https://app.fieldcompass.example.org   (the application)
# Both names need an A record pointing at this VM before Caddy can get certs.
# ---------------------------------------------------------------------------
# PRODUCTION TOPOLOGY
#
#   https://fieldcompass.org      -> marketing site, Cloudflare Workers (site/)
#   https://www.fieldcompass.org  -> 301 to the apex, Cloudflare redirect rule
#   https://app.fieldcompass.org  -> THIS VM. Caddy, auto TLS.
#
# The VM serves only the application. DNS:
#     app.fieldcompass.org   A      <vm-ip>          (DNS only / grey cloud)
#     fieldcompass.org       Cloudflare Worker custom domain (auto, proxied)
#     www.fieldcompass.org   Cloudflare Worker custom domain (auto, proxied)
#
# Set on the VM to go live:
#     SITE_ADDRESS=https://app.fieldcompass.org
#     CORS_ORIGINS=https://app.fieldcompass.org
# then: docker compose -f docker-compose.prod.yml up -d caddy
#
# Wait for app.fieldcompass.org to resolve BEFORE redeploying -- Caddy requests
# its certificate on startup, and a name that does not resolve fails the ACME
# challenge and counts against Let's Encrypt rate limits. Keep that record
# "DNS only" in Cloudflare: a proxied record terminates TLS at Cloudflare and
# the HTTP-01 challenge cannot complete.
#
# WWW_ADDRESS and WWW_REDIRECT_FROM stay UNSET. They serve the marketing site
# from this VM, which is the fallback path if you ever pull it off Cloudflare; unset
# they bind unpublished ports and do nothing.
# ---------------------------------------------------------------------------
#
# BEFORE DNS IS LIVE (the shipped defaults): with only a VM IP there is no
# HTTPS -- Let's Encrypt cannot certify a bare IP -- and no hostname to tell
# two sites apart on port 80, so the split is port-based:
#   SITE_ADDRESS=:80     -> the app,            http://<vm-ip>/
#   WWW_ADDRESS=:8080    -> the marketing site, http://<vm-ip>:8080/
# Demo-only: every password typed into the login form crosses in clear.

# The ORIGIN the frontend sends API requests to. Request paths already include
# the /api prefix, so this must be an origin, not a path.
# Behind the bundled Caddy proxy the API is same-origin: leave this EMPTY and
# leave API_ORIGIN empty too. ("/api" is also accepted, for deployments that
# were set up when the docs recommended it.)
VITE_API_URL=

# ONLY if VITE_API_URL is an absolute URL pointing at a different origin.
# Two things must then be set, or the app breaks in ways that look unrelated:
#   API_ORIGIN   - added to the page's Content-Security-Policy connect-src.
#                  Without it the BROWSER blocks every API call, including
#                  login, before the request is even sent -- and CORS_ORIGINS
#                  cannot help, because the request never leaves the page.
#   CORS_ORIGINS - must contain the SITE's origin (set on the API side).
# Example: VITE_API_URL=https://api.example.org
#          API_ORIGIN=https://api.example.org
API_ORIGIN=

# ============================================================================
# KoboToolbox API Configuration
# ============================================================================
# NOTE: in production each USER supplies their own Kobo token through the UI
# (stored encrypted with ENCRYPTION_KEY). This global token is a local
# development convenience only and can be left blank in production.
# Get your API token from: https://kf.kobotoolbox.org/token/
KOBO_API_TOKEN=your_kobo_api_token_here

# Kobo API base URL (usually the default, but can be customized)
KOBO_API_URL=https://kf.kobotoolbox.org/api/v2

# ============================================================================
# Application Settings
# ============================================================================
ENVIRONMENT=development
LOG_LEVEL=INFO

# ============================================================================
# OpenAI Configuration (for AI-powered rule generation)
# ============================================================================
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=1000
OPENAI_TEMPERATURE=0.2
