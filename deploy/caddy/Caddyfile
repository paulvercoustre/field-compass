# =============================================================================
# Field Compass reverse proxy
# =============================================================================
# Replaces the previous nginx config to get automatic HTTPS.
#
# SITE_ADDRESS controls how this is served:
#
#   https://fieldcompass.example.org   <- a DOMAIN you control.
#                                         Caddy obtains and renews a free
#                                         Let's Encrypt certificate itself.
#                                         This is the only option that gives
#                                         real, browser-trusted HTTPS.
#
#   :80                                <- plain HTTP, no certificate.
#                                         Only acceptable for a throwaway demo
#                                         with no real user accounts, because
#                                         passwords cross the network in clear.
#
# Let's Encrypt cannot issue certificates for a bare IP address, so if you only
# have the VM's public IP you must either point a domain at it or accept :80.
# =============================================================================

{$SITE_ADDRESS::80} {
	encode gzip zstd

	header {
		# Don't advertise the server software
		-Server
		# Block MIME-type sniffing
		X-Content-Type-Options "nosniff"
		# Block framing (clickjacking)
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Ignored by browsers over plain HTTP, so it is safe to always send
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# The app bundles all of its JS/CSS -- no third-party origins needed.
		# 'unsafe-inline' for styles only: React/Recharts set style attributes.
		#
		# connect-src also allows API_ORIGIN. This matters when VITE_API_URL is
		# set to an absolute URL instead of the default "/api": the frontend
		# then calls a DIFFERENT origin, and 'self' alone would block every
		# request -- login included -- before CORS was ever consulted. Leave
		# API_ORIGIN empty whenever VITE_API_URL is "/api" (same-origin).
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' {$API_ORIGIN:}; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
	}

	# Sampling-frame uploads (CSV/XLSX) need headroom. nginx's 1MB default
	# would have rejected them with an opaque 413.
	request_body {
		max_size 25MB
	}

	# Caddy sets X-Forwarded-For / X-Forwarded-Proto automatically, which is
	# what the backend rate limiter reads when TRUST_PROXY_HEADERS is enabled.
	handle /api/* {
		reverse_proxy backend:8000
	}

	handle /health {
		reverse_proxy backend:8000
	}

	# Single-page app: unknown paths fall back to index.html
	handle {
		root * /usr/share/caddy/html
		try_files {path} /index.html
		file_server
	}
}

# =============================================================================
# Marketing site (../../site) — served on its own hostname.
# =============================================================================
# Best practice is to keep the public site and the authenticated app on
# separate origins:
#
#   WWW_ADDRESS  = https://fieldcompass.example.org   <- this block
#   SITE_ADDRESS = https://app.fieldcompass.example.org <- the app, above
#
# The separation buys two things. The app's session cookies and tokens are
# scoped to the app origin, so nothing the marketing page ever loads can read
# them. And the marketing page can have the looser policy it needs (webfonts)
# without weakening the app's policy by one directive.
#
# WWW_ADDRESS defaults to :8081, a port docker-compose.prod.yml does NOT
# publish. Leaving it unset therefore changes nothing about an existing
# deployment: the block exists but is unreachable from outside the host.
# Point both hostnames at this VM's IP with A records before setting it, or
# Caddy's certificate request for the new name will fail.
# =============================================================================

{$WWW_ADDRESS::8081} {
	encode gzip zstd

	header {
		-Server
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# Deliberately NOT the app's policy. This origin holds no session and
		# talks to no API, and it loads Inter from Google Fonts.
		# 'unsafe-inline' for styles only: the dashboard illustration sets bar
		# heights with style attributes, same reason the app needs it.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
	}

	# Static files only — no API, no SPA fallback.
	root * /usr/share/caddy/site
	file_server
}
